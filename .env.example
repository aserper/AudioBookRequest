# AudioBookRequest Environment Configuration
# Copy this file to .env and customize the values for your deployment

# =================================
# PostgreSQL Configuration
# =================================
# These variables are used when running with --profile postgresql

# Database connection settings
POSTGRES_DB=audiobookrequest
POSTGRES_USER=audiobookrequest
POSTGRES_PASSWORD=change_this_secure_password

# AudioBookRequest PostgreSQL settings
ABR_DB__TYPE=postgresql
ABR_DB__POSTGRESQL__HOST=postgres
ABR_DB__POSTGRESQL__PORT=5432
ABR_DB__POSTGRESQL__USER=audiobookrequest
ABR_DB__POSTGRESQL__PASSWORD=change_this_secure_password
ABR_DB__POSTGRESQL__DATABASE=audiobookrequest

# =================================
# Application Configuration
# =================================
# Common settings for both SQLite and PostgreSQL deployments

# Application settings
ABR_APP__PORT=8000
ABR_APP__DEBUG=false
ABR_APP__LOG_LEVEL=INFO
ABR_APP__CONFIG_DIR=/config

# Security settings
ABR_APP__INIT_ROOT_USERNAME=admin
ABR_APP__INIT_ROOT_PASSWORD=change_this_admin_password

# Authentication (optional)
# ABR_APP__FORCE_LOGIN_TYPE=basic
# ABR_APP__BASE_URL=

# Default region for search
ABR_APP__DEFAULT_REGION=us